# ========================================================
# The Detective's Desk - Environment Configuration
# ========================================================

# 1. OPTIONAL: Cloud MySQL / TiDB / Aiven / PlanetScale Database URL
# If omitted, the game automatically uses the built-in resilient serverless storage
# Example TiDB Serverless / Aiven connection URI:
# MYSQL_URL="mysql://username:password@gateway.tidbcloud.com:4000/detective_desk?ssl=true"

# Or individual parameters:
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_USER="root"
# MYSQL_PASSWORD=""
# MYSQL_DATABASE="detective_desk"
# MYSQL_SSL="false"

# 2. JWT Session Secret (Random secure string)
JWT_SECRET="the-detectives-desk-secret-noir-1940-cryptic-vault"

# 3. Environment mode
NODE_ENV="production"

